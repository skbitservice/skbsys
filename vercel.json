{
  "version": 2,
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/server.js"
    },
    {
      "src": "/admin(.*)",
      "dest": "/frontend/admin.html"
    },
    {
      "src": "/engineer(.*)",
      "dest": "/frontend/engineer.html"
    },
    {
      "src": "/portal(.*)",
      "dest": "/frontend/portal.html"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}
